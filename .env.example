# Runtime and GCS (required for the end-to-end pipeline)
SANTANDER_DATA_ROOT=data
SANTANDER_DUCKDB_TEMP_DIRECTORY=data/.duckdb_tmp
GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_CLOUD_PROJECT=your-gcp-project
GCS_BUCKET=your-gcs-bucket
GCS_RAW_PREFIX=santander/raw
GCS_CHECKPOINT_PREFIX=santander/checkpoints

# MLflow: local tracking is portable and needs no additional account.
MLFLOW_TRACKING_URI=sqlite:///absolute/path/to/mlflow.db
MLFLOW_EXPERIMENT_NAME=santander-baselines

# DVC remote. Supply a gs:// URL and an Application Default Credential or a
# service-account key-file path accepted by the Google Cloud SDK/DVC.
DVC_REMOTE_URL=gs://your-gcs-bucket/santander/dvc
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
